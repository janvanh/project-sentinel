%% ============================================================
%%  sentinel-style.sty
%%  Shared visual template for Project Sentinel documents.
%%  Used by BOTH the Project Bible and the Technical Specification.
%%
%%  You should not normally need to edit this file.
%%  Project-wide values live in:   project-config.tex
%%  Per-document values live in:   <doc>/doc-config.tex
%% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sentinel-style}[2026/08/22 Project Sentinel document style]

\RequirePackage{ifxetex}
\RequirePackage{ifluatex}
\RequirePackage{tikz}
\newif\ifsentinel@xoru
\ifxetex\sentinel@xorutrue\fi
\ifluatex\sentinel@xorutrue\fi
\ifsentinel@xoru\else
  \PackageError{sentinel-style}{This template requires XeLaTeX or LuaLaTeX}
    {Compile with xelatex or lualatex, not pdflatex.}
\fi

%% ---------------------------------------------------------------
%% 1. PAGE GEOMETRY
%% ---------------------------------------------------------------
\RequirePackage[a4paper,top=3.2cm,bottom=3cm,inner=3.2cm,outer=2.7cm,
                 headheight=15pt,headsep=22pt,footskip=1.4cm]{geometry}

\setlength{\parindent}{0pt}
%% ---------------------------------------------------------------
%% 2. COLOUR PALETTE  (Navy / Bronze / Slate)
%%    Adjust these three lines to re-theme the whole template.
%% ---------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{sentinelNavy}{HTML}{1B2A4A}   % primary — headings, links
\definecolor{sentinelBronze}{HTML}{B08D57} % accent  — rules, tags, ornaments
\definecolor{sentinelSlate}{HTML}{5B6470}  % secondary — header/footer text
\definecolor{sentinelHair}{HTML}{D8D2C4}   % hairline rules / faint dividers
\definecolor{sentinelInk}{HTML}{1E1E1E}    % body text (near-black, not pure)

%% ---------------------------------------------------------------
%% 3. FONTS
%%    Modern, freely available pairing: Noto Serif (body) / Noto Sans
%%    (headings, UI chrome). Falls back to Latin Modern automatically
%%    if Noto isn't installed, so the template always compiles.
%%
%%    Debian/Texmaker users: sudo apt install fonts-noto-core
%% ---------------------------------------------------------------
\RequirePackage{fontspec}

\IfFontExistsTF{Noto Serif}{
  \setmainfont{Noto Serif}
}{
  \setmainfont{Latin Modern Roman}
}
\IfFontExistsTF{Noto Sans}{
  \setsansfont{Noto Sans}
  \newfontfamily\sentinelheadfont{Noto Sans}[
    UprightFont = *, BoldFont = * Bold, ItalicFont = * Italic]
}{
  \setsansfont{Latin Modern Sans}
  \newfontfamily\sentinelheadfont{Latin Modern Sans}
}
\IfFontExistsTF{Noto Sans Mono}{
  \setmonofont{Noto Sans Mono}[Scale=0.9]
  \newfontfamily\sentinelmonofont{Noto Sans Mono}[Scale=0.9]
}{
  \setmonofont{Latin Modern Mono}[Scale=0.9]
  \newfontfamily\sentinelmonofont{Latin Modern Mono}[Scale=0.9]
}

\color{sentinelInk}

%% ---------------------------------------------------------------
%% 4. DOCUMENT / PROJECT VARIABLES
%%    Defaults here; project-config.tex and doc-config.tex override
%%    these with \renewcommand before \begin{document}.
%% ---------------------------------------------------------------
\newcommand{\ProjectName}{Project Sentinel}
\newcommand{\ProjectTagline}{Privacy Automation Platform}

\newcommand{\DocTitle}{Untitled Document}
\newcommand{\DocSubtitle}{}
\newcommand{\DocVersion}{0.0}
\newcommand{\DocStatus}{Draft}
\newcommand{\DocAuthor}{Author Name}
\newcommand{\DocDate}{\today}

%% Convenience setters, used in doc-config.tex files. Example:
%%   \SetDocTitle{Technical Specification}
\newcommand{\SetDocTitle}[1]{\renewcommand{\DocTitle}{#1}}
\newcommand{\SetDocSubtitle}[1]{\renewcommand{\DocSubtitle}{#1}}
\newcommand{\SetDocVersion}[1]{\renewcommand{\DocVersion}{#1}}
\newcommand{\SetDocStatus}[1]{\renewcommand{\DocStatus}{#1}}
\newcommand{\SetDocAuthor}[1]{\renewcommand{\DocAuthor}{#1}}
\newcommand{\SetDocDate}[1]{\renewcommand{\DocDate}{#1}}
\newcommand{\SetProjectName}[1]{\renewcommand{\ProjectName}{#1}}
\newcommand{\SetProjectTagline}[1]{\renewcommand{\ProjectTagline}{#1}}

%% ---------------------------------------------------------------
%% 5. HYPERLINKS  (also makes the ToC clickable, requirement 5)
%% ---------------------------------------------------------------
\RequirePackage{hyperref}
\hypersetup{
  colorlinks   = true,
  linkcolor    = sentinelNavy,
  citecolor    = sentinelNavy,
  urlcolor     = sentinelBronze,
  linktoc      = all,          % chapter AND section entries are clickable
  bookmarksopen = true,
  bookmarksnumbered = true,
  pdfstartview = {FitH}
}

%% ---------------------------------------------------------------
%% 6. SECTIONING STYLE
%% ---------------------------------------------------------------
\RequirePackage{titlesec}

% Chapters: small bronze "CHAPTER N" eyebrow tag, large navy title,
% thin bronze rule underneath.
\titleformat{\chapter}[display]
  {\normalfont\sentinelheadfont}
  {\filright\small\bfseries\color{sentinelBronze}%
   \MakeUppercase{\chaptertitlename}\ \thechapter}
  {6pt}
  {\Huge\bfseries\color{sentinelNavy}}
  [\vspace{6pt}{\color{sentinelBronze}\titlerule[1pt]}\vspace{18pt}]
\titlespacing*{\chapter}{0pt}{0.5cm}{0.3cm}

\titleformat{\section}
  {\normalfont\sentinelheadfont\Large\bfseries\color{sentinelNavy}}
  {\thesection}{0.6em}{}
\titleformat{\subsection}
  {\normalfont\sentinelheadfont\large\bfseries\color{sentinelSlate}}
  {\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  {\normalfont\sentinelheadfont\normalsize\bfseries\itshape\color{sentinelSlate}}
  {\thesubsubsection}{0.6em}{}

\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

%% ---------------------------------------------------------------
%% 7. TABLE OF CONTENTS STYLE
%%    Uses titletoc (titlesec's own companion package) rather than
%%    tocloft — tocloft is known to clash with titlesec's chapter
%%    redefinition, causing hard-to-diagnose low-level errors.
%% ---------------------------------------------------------------
\RequirePackage{titletoc}
\setcounter{tocdepth}{2}

\titlecontents{chapter}[0pt]
  {\vspace{12pt}\sentinelheadfont\bfseries\large\color{sentinelNavy}}
  {\contentslabel{1.6em}}
  {}
  {\hfill\sentinelheadfont\color{sentinelNavy}\contentspage}
  [\vspace{2pt}]

\titlecontents{section}[2.3em]
  {\normalfont\color{sentinelInk}}
  {\contentslabel{2.9em}}
  {}
  {\dotfill\contentspage}
  [\vspace{1pt}]

\newcommand{\sentineltocheading}{%
  \begingroup
  \sentinelheadfont\bfseries\Huge\color{sentinelNavy}Table of Contents\par
  \vspace{2pt}
  \noindent{\color{sentinelBronze}\rule{\linewidth}{1.2pt}}
  \vspace{18pt}
  \endgroup
}
% Custom ToC: skips report.cls's own \chapter*{...} heading entirely
% (which would force an unwanted extra page break) and typesets our
% own styled heading directly above the entry list.
% Installed via \AtBeginDocument so it wins over any late redefinition
% made during document startup.
\AtBeginDocument{%
  \renewcommand{\tableofcontents}{%
    \clearpage
    \pagestyle{empty}
    \sentineltocheading
    \@starttoc{toc}%
    \clearpage
    \setcounter{page}{1}
    \pagestyle{sentinel}
  }%
}

%% ---------------------------------------------------------------
%% 8. HEADER / FOOTER  (requirements 1 & 2)
%%    Active from the first content page after the ToC onward.
%%    Chapter opening pages use a lighter header (no rule); all
%%    other pages show the full header + footer.
%% ---------------------------------------------------------------
\RequirePackage{fancyhdr}

\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{{\color{sentinelHair}\hrule height\headrulewidth}}

\fancypagestyle{sentinel}{
  \fancyhf{}
  \fancyhead[L]{\sentinelheadfont\footnotesize\color{sentinelSlate}%
                \MakeUppercase{\ProjectName}\ \textbar\ \DocTitle}
  \fancyhead[R]{\sentinelheadfont\footnotesize\color{sentinelSlate}%
                \MakeUppercase{\leftmark}}
  \fancyfoot[L]{\sentinelheadfont\footnotesize\color{sentinelSlate}%
                v\DocVersion\ \textbar\ \DocStatus}
  \fancyfoot[C]{\sentinelheadfont\footnotesize\color{sentinelBronze}\thepage}
  \fancyfoot[R]{\sentinelheadfont\footnotesize\color{sentinelSlate}%
                \ProjectTagline}
}

% Chapter-opening pages: keep it quiet — footer only, no header rule.
\fancypagestyle{sentinelchapter}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[L]{\sentinelheadfont\footnotesize\color{sentinelSlate}%
                v\DocVersion\ \textbar\ \DocStatus}
  \fancyfoot[C]{\sentinelheadfont\footnotesize\color{sentinelBronze}\thepage}
  \fancyfoot[R]{\sentinelheadfont\footnotesize\color{sentinelSlate}%
                \ProjectTagline}
}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
% Every \chapter automatically gets the "sentinelchapter" style on its
% first page (titlesec's own hook for this — safe with its \chapter redefinition):
\assignpagestyle{\chapter}{sentinelchapter}

\pagestyle{sentinel}

%% ---------------------------------------------------------------
%% 9. CHAPTER-END ORNAMENT  (requirement 4 — clear separation)
%%    Place \sentinelchapterend at the end of every chapter file.
%%    Because chapters are brought in with \include, each one
%%    already starts on a fresh page — this ornament marks the
%%    close of the chapter explicitly before that page break.
%% ---------------------------------------------------------------
\newcommand{\sentinelchapterend}{%
  \vfill
  \begin{center}
    {\color{sentinelBronze}%
     \rule{2.2cm}{0.5pt}\hspace{6pt}%
     \rule[0.15em]{0.11cm}{0.11cm}\hspace{6pt}%
     \rule{2.2cm}{0.5pt}}
  \end{center}
}

%% ---------------------------------------------------------------
%% 10. MISC — lists, tables, note boxes
%% ---------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=4pt}
\setlist[itemize]{label=\textcolor{sentinelBronze}{\textemdash}}

\setlist[enumerate,1]{label=\textcolor{sentinelBronze}{\arabic*.}}
\setlist[enumerate,2]{label=\textcolor{sentinelBronze}{\alph*.}}
\setlist[enumerate,3]{label=\textcolor{sentinelBronze}{\roman*.}}

\RequirePackage{booktabs}
\RequirePackage[most]{tcolorbox}

% A callout box for definitions, examples, warnings — matches the
% palette so it never fights the page for attention.
\newtcolorbox{sentinelnote}[1][Note]{
  colback=white, colframe=sentinelBronze,
  colbacktitle=sentinelNavy, coltitle=white,
  fonttitle=\sentinelheadfont\bfseries\small,
  boxrule=0.4pt, left=8pt, right=8pt, top=4pt, bottom=4pt,
  title={#1}, arc=0pt, outer arc=0pt
}

\usepackage{tikz}
\usetikzlibrary{arrows.meta}

\usepackage{amssymb}
\newcommand{\checkbox}{%
    \tikz\draw[thick] (0,0) rectangle (0.2,0.2);%
}

\newcommand{\checkedbox}{%
    \tikz\draw[thick] (0,0) rectangle (0.2,0.2)
        (0.03,0.1) -- (0.08,0.04) -- (0.17,0.16);%
}

%% ---------------------------------------------------------------
%% 11. TITLE PAGE  (requirement 6)
%%    Call \sentineltitlepage after setting the Doc* variables.
%% ---------------------------------------------------------------
\newcommand{\sentineltitlepage}{%
  \begin{titlepage}
    \newgeometry{top=4.5cm,bottom=4cm,left=3.2cm,right=3.2cm}
    \pagestyle{empty}
    \begin{center}
      % --- mark ---
      \begin{tikzpicture}
        \draw[sentinelBronze, line width=1pt] (0,0) circle (0.55cm);
        \draw[sentinelNavy, line width=1pt] (0,0) circle (0.4cm);
        \fill[sentinelNavy] (0,0) circle (0.05cm);
      \end{tikzpicture}

      \vspace{1.4cm}
      {\sentinelheadfont\bfseries\fontsize{34}{40}\selectfont\color{sentinelNavy}
        \ProjectName\par}
      \vspace{0.25cm}
      {\sentinelheadfont\itshape\Large\color{sentinelSlate}\ProjectTagline\par}

      \vspace{0.9cm}
      {\color{sentinelBronze}\rule{6.5cm}{0.8pt}}
      \vspace{0.9cm}

      {\sentinelheadfont\bfseries\LARGE\color{sentinelInk}\DocTitle\par}
      \ifx\DocSubtitle\@empty\else
        \vspace{0.2cm}{\sentinelheadfont\large\itshape\color{sentinelSlate}\DocSubtitle\par}
      \fi

      \vfill

      {\sentinelheadfont\small\color{sentinelSlate}
        \begin{tabular}{r l}
          \textsc{Document Version} & \DocVersion \\[2pt]
          \textsc{Status}           & \DocStatus \\[2pt]
          \textsc{Author}           & \DocAuthor \\[2pt]
          \textsc{Date}             & \DocDate \\
        \end{tabular}\par}

      \vspace{1.2cm}
      {\color{sentinelHair}\rule{\textwidth}{0.4pt}}
    \end{center}
    \restoregeometry
  \end{titlepage}
}

\endinput
